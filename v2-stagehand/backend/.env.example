# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Automatio Machinae"
VERSION="1.0.2"
ENVIRONMENT=development
# Options: development, production
DEBUG=True
# Options: True, False
VERBOSE=2

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:8501"

# =============================================================================
# BROWSERBASE CONFIGURATION (Required)
# =============================================================================
# Get your API key and project ID from https://www.browserbase.com
STAGEHAND_ENV=BROWSERBASE
# Options: BROWSERBASE or LOCAL
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Stagehand Settings
DOM_SETTLE_TIMEOUT_MS=30000
SELF_HEAL=true

# =============================================================================
# BROWSER SETTINGS
# =============================================================================
HEADLESS=False
# Options: True, False
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
PAGE_TIMEOUT_MS=30000
PAGE_NAVIGATION_TIMEOUT_MS=120000
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=15

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# LLM CONFIGURATION (Required) - For Single-Step and Multi-Step Workflows
# =============================================================================
# Get your API key from https://openrouter.ai
MODEL_API_KEY=
MODEL_NAME=google/gemini-2.5-flash
MODEL_BASE_URL=

# =============================================================================
# CUA MODEL CONFIGURATION - For Agent Workflows
# =============================================================================
## Computer Use Agent (CUA) Model Configuration
## Used specifically for autonomous agent workflows

ENABLE_MICROSOFT_CUA=
# Options: True, False
AGENT_MODEL_NAME=microsoft/Fara-7B
# Options: microsoft/Fara-7B, gemini-2.5-computer-use-preview-10-2025

# Optional: Separate API key for CUA model (defaults to MODEL_API_KEY if not set)
AGENT_MODEL_API_KEY=

# Optional: Separate base URL for CUA model (defaults to MODEL_BASE_URL if not set)
AGENT_MODEL_BASE_URL=

